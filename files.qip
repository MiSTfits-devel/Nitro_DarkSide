# Explicit dependency-ordered file list (mirrors sim/run_analyze_all.sh,
# the proven nvc analysis order): Quartus 17 analyzes VHDL in listing
# order, and packages (pexport, pProc_bus_gba, ...) must come before
# their users - the sim-era rtl/nds.qip is not ordered for that.
set_global_assignment -name VHDL_FILE rtl/SyncFifo.vhd
set_global_assignment -name VHDL_FILE rtl/SyncFifoFallThrough.vhd
set_global_assignment -name VHDL_FILE rtl/SyncRam.vhd
set_global_assignment -name VHDL_FILE rtl/SyncRamDual.vhd
set_global_assignment -name VHDL_FILE rtl/SyncRamDualByteEnable.vhd
set_global_assignment -name VHDL_FILE rtl/SyncRamDualNotPow2.vhd
set_global_assignment -name VHDL_FILE rtl/export.vhd
set_global_assignment -name VHDL_FILE rtl/proc_bus_gba.vhd
set_global_assignment -name VHDL_FILE rtl/reg_savestates.vhd
set_global_assignment -name VHDL_FILE rtl/gba_cpu.vhd
set_global_assignment -name VHDL_FILE rtl/dpram.vhd
set_global_assignment -name VHDL_FILE rtl/DDR3Mux.vhd
set_global_assignment -name VHDL_FILE rtl/reggba_timer.vhd
set_global_assignment -name VHDL_FILE rtl/gba_timer_module.vhd
set_global_assignment -name VHDL_FILE rtl/gba_timer.vhd
set_global_assignment -name VHDL_FILE rtl/nds_vram_map.vhd
set_global_assignment -name VHDL_FILE rtl/nds_vram.vhd
set_global_assignment -name VHDL_FILE rtl/nds_wram.vhd
set_global_assignment -name VHDL_FILE rtl/nds_mainram.vhd
set_global_assignment -name VHDL_FILE rtl/nds_irq.vhd
set_global_assignment -name VHDL_FILE rtl/nds_ipc.vhd
set_global_assignment -name VHDL_FILE rtl/nds_spi.vhd
set_global_assignment -name VHDL_FILE rtl/nds_membus7.vhd
set_global_assignment -name VHDL_FILE rtl/nds_cpu9.vhd
set_global_assignment -name VHDL_FILE rtl/nds_cache9.vhd
set_global_assignment -name VHDL_FILE rtl/nds_membus9.vhd
set_global_assignment -name VHDL_FILE rtl/nds_syscnt.vhd
set_global_assignment -name VHDL_FILE rtl/nds_loader.vhd
# nds_debug is a leaf (no work-library dependencies of its own) but must precede
# nds_top, which instantiates it - Quartus analyses VHDL in the order listed.
set_global_assignment -name VHDL_FILE rtl/nds_debug.vhd
set_global_assignment -name VHDL_FILE rtl/nds_perf.vhd
set_global_assignment -name VHDL_FILE rtl/nds_card.vhd
set_global_assignment -name VHDL_FILE rtl/nds_rtc.vhd
set_global_assignment -name VHDL_FILE rtl/nds_sound.vhd
set_global_assignment -name VHDL_FILE rtl/reg_nds_display.vhd
set_global_assignment -name VHDL_FILE rtl/nds_drawer_text.vhd
set_global_assignment -name VHDL_FILE rtl/nds_drawer_affine.vhd
set_global_assignment -name VHDL_FILE rtl/nds_drawer_extended.vhd
set_global_assignment -name VHDL_FILE rtl/nds_drawer_obj.vhd
set_global_assignment -name VHDL_FILE rtl/nds_drawer_merge.vhd
set_global_assignment -name VHDL_FILE rtl/nds_gpu2d.vhd
set_global_assignment -name VHDL_FILE rtl/nds_gpu2d_fast.vhd
set_global_assignment -name VHDL_FILE rtl/nds_gpu_timing.vhd
set_global_assignment -name VHDL_FILE rtl/nds_dma9.vhd
set_global_assignment -name VHDL_FILE rtl/nds_dma7.vhd
set_global_assignment -name VHDL_FILE rtl/nds_bios7.vhd
set_global_assignment -name VHDL_FILE rtl/nds_bios9.vhd
set_global_assignment -name VHDL_FILE rtl/nds_top.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ddram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/nds_fb_ddr3.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/nds_audio_ddr3.sv
# HPS lightweight-bridge slave (AXI-3 at 0xFF200000). Instantiates the
# cyclonev_hps_interface_hps2fpga_light_weight WYSIWYG, so it is Cyclone V only.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/hps_lw_bridge.sv
set_global_assignment -name VHDL_FILE nds_port_wrap.vhd
set_global_assignment -name SYSTEMVERILOG_FILE NDS.sv
set_global_assignment -name SDC_FILE NDS.sdc
