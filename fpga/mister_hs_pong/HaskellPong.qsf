# SPDX-License-Identifier: GPL-3.0-or-later
set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"
# Pong's pixel art does not need the polyphase scaler's coefficient datapath.
set_global_assignment -name VERILOG_MACRO "NDS_FORCE_NEAREST=1"
set_instance_assignment -name OPTIMIZATION_TECHNIQUE SPEED -to ascal
set_instance_assignment -name OPTIMIZATION_TECHNIQUE SPEED -to hdmi_osd
# The shell's HDMI timing registers are 12 bits; two guard bits cover OSD
# offset/scale arithmetic. Avoid a 22-bit line-period carry chain on HDMI.
set_parameter -entity sys_top -to hdmi_osd -name OSD_COUNTER_BITS 14
source sys/sys.tcl
source sys/sys_analog.tcl
set_global_assignment -name SYSTEMVERILOG_FILE sys/nds_native_osd_memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE sys/nds_dv1_osd_raster.sv
set_global_assignment -name SYSTEMVERILOG_FILE emu.sv
set_global_assignment -name VERILOG_FILE hs_pong.v
