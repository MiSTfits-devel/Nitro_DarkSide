@@ -3315,6 +3318,22 @@ void ARM9IOWrite8(u32 addr, u8 val)
 {
     switch (addr)
     {
+    case 0x04000180:
+        return; // input nibble, read-only
+    case 0x04000181:
+    {
+        u16 v16 = ((u16)val) << 8;
+        IPCSync7 &= 0xFFF0;
+        IPCSync7 |= ((v16 & 0x0F00) >> 8);
+        IPCSync9 &= 0xB0FF;
+        IPCSync9 |= (v16 & 0x4F00);
+        if ((v16 & 0x2000) && (IPCSync7 & 0x4000))
+        {
+            SetIRQ(1, IRQ_IPCSync);
+        }
+        return;
+    }
+
     case 0x0400006C:
     case 0x0400006D: GPU::GPU2D_A.Write8(addr, val); return;
     case 0x0400106C:
@@ -3778,6 +3797,9 @@ u8 ARM7IORead8(u32 addr)
 {
     switch (addr)
     {
+    case 0x04000180: return IPCSync7 & 0xFF;
+    case 0x04000181: return (IPCSync7 >> 8) & 0xFF;
+
     case 0x04000130: return KeyInput & 0xFF;
     case 0x04000131: return (KeyInput >> 8) & 0xFF;
     case 0x04000132: return KeyCnt & 0xFF;
@@ -4047,6 +4069,22 @@ void ARM7IOWrite8(u32 addr, u8 val)
 {
     switch (addr)
     {
+    case 0x04000180:
+        return; // input nibble, read-only
+    case 0x04000181:
+    {
+        u16 v16 = ((u16)val) << 8;
+        IPCSync9 &= 0xFFF0;
+        IPCSync9 |= ((v16 & 0x0F00) >> 8);
+        IPCSync7 &= 0xB0FF;
+        IPCSync7 |= (v16 & 0x4F00);
+        if ((v16 & 0x2000) && (IPCSync9 & 0x4000))
+        {
+            SetIRQ(0, IRQ_IPCSync);
+        }
+        return;
+    }
+
     case 0x04000132:
