+// --- NDS_MiSTfits differential-trace hook (see docs/TRACE_DIFF.md there) ---
+// One line per retired instruction: <pc> <opcode> <cpsr> <r0>..<r14>.
+// pc is the pipeline value captured before execution (addr+8 ARM, +4 Thumb),
+// cpsr/regs are post-execute — matching the RTL export in nds_cpu9.
+FILE* ARM9TraceFile = nullptr;
+u64 ARM9TraceCount = 0;
+u64 ARM9TraceMax = 0;
+
+static inline void ARM9TraceLine(u32 pc, u32 instr, u32 cpsr, u32* r)
+{
+    if (!ARM9TraceFile || ARM9TraceCount >= ARM9TraceMax) return;
+    fprintf(ARM9TraceFile, "%08x %08x %08x", pc, instr, cpsr);
+    for (int i = 0; i < 15; i++) fprintf(ARM9TraceFile, " %08x", r[i]);
+    fputc('\n', ARM9TraceFile);
+    ARM9TraceCount++;
+}
+
+FILE* ARM7TraceFile = nullptr;
+u64 ARM7TraceCount = 0;
+u64 ARM7TraceMax = 0;
+
+static inline void ARM7TraceLine(u32 pc, u32 instr, u32 cpsr, u32* r)
+{
+    if (!ARM7TraceFile || ARM7TraceCount >= ARM7TraceMax) return;
+    fprintf(ARM7TraceFile, "%08x %08x %08x", pc, instr, cpsr);
+    for (int i = 0; i < 15; i++) fprintf(ARM7TraceFile, " %08x", r[i]);
+    fputc('\n', ARM7TraceFile);
+    ARM7TraceCount++;
+}
+
