diff --git a/src/ARM.cpp b/src/ARM.cpp
index e19cb00..b8a8656 100644
--- a/src/ARM.cpp
+++ b/src/ARM.cpp
@@ -567,6 +567,23 @@ void ARMv5::DataAbort()
     JumpTo(ExceptionBase + 0x10);
 }
 
+// --- NDS_MiSTfits differential-trace hook (see docs/TRACE_DIFF.md there) ---
+// One line per retired instruction: <pc> <opcode> <cpsr> <r0>..<r14>.
+// pc is the pipeline value captured before execution (addr+8 ARM, +4 Thumb),
+// cpsr/regs are post-execute — matching the RTL export in nds_cpu9.
+FILE* ARM9TraceFile = nullptr;
+u64 ARM9TraceCount = 0;
+u64 ARM9TraceMax = 0;
+
+static inline void ARM9TraceLine(u32 pc, u32 instr, u32 cpsr, u32* r)
+{
+    if (!ARM9TraceFile || ARM9TraceCount >= ARM9TraceMax) return;
+    fprintf(ARM9TraceFile, "%08x %08x %08x", pc, instr, cpsr);
+    for (int i = 0; i < 15; i++) fprintf(ARM9TraceFile, " %08x", r[i]);
+    fputc('\n', ARM9TraceFile);
+    ARM9TraceCount++;
+}
+
 void ARMv5::Execute()
 {
     if (Halted)
@@ -600,8 +617,10 @@ void ARMv5::Execute()
             else             NextInstr[1] = CodeRead32(R[15], false);
 
             // actually execute
+            u32 trace_pc = R[15];
             u32 icode = (CurInstr >> 6) & 0x3FF;
             ARMInterpreter::THUMBInstrTable[icode](this);
+            ARM9TraceLine(trace_pc, CurInstr & 0xFFFF, CPSR, R);
         }
         else
         {
@@ -612,6 +631,7 @@ void ARMv5::Execute()
             NextInstr[1] = CodeRead32(R[15], false);
 
             // actually execute
+            u32 trace_pc = R[15];
             if (CheckCondition(CurInstr >> 28))
             {
                 u32 icode = ((CurInstr >> 4) & 0xF) | ((CurInstr >> 16) & 0xFF0);
@@ -623,6 +643,7 @@ void ARMv5::Execute()
             }
             else
                 AddCycles_C();
+            ARM9TraceLine(trace_pc, CurInstr, CPSR, R);
         }
 
         // TODO optimize this shit!!!
