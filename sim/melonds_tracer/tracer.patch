+// --- NDS_MiSTfits differential-trace hook (see docs/TRACE_DIFF.md there) ---
+// One line per retired instruction: <pc> <opcode> <cpsr> <r0>..<r14>.
+// pc is the pipeline value captured before execution (addr+8 ARM, +4 Thumb),
+// cpsr/regs are post-execute — matching the RTL export in nds_cpu9.
+FILE* ARM9TraceFile = nullptr;
+u64 ARM9TraceCount = 0;
+u64 ARM9TraceMax = 0;
+
+static inline void ARM9TraceLine(u32 pc, u32 instr, u32 cpsr, u32* r)
+{
+    if (!ARM9TraceFile || ARM9TraceCount >= ARM9TraceMax) return;
+    fprintf(ARM9TraceFile, "%08x %08x %08x", pc, instr, cpsr);
+    for (int i = 0; i < 15; i++) fprintf(ARM9TraceFile, " %08x", r[i]);
+    fputc('\n', ARM9TraceFile);
+    ARM9TraceCount++;
+}
+
+FILE* ARM7TraceFile = nullptr;
+u64 ARM7TraceCount = 0;
+u64 ARM7TraceMax = 0;
+
+static inline void ARM7TraceLine(u32 pc, u32 instr, u32 cpsr, u32* r)
+{
+    // NDS_MiSTfits: ARM7PROBE_LO/HI (hex) report the FIRST execution inside an
+    // address window, with the CPSR so the T bit is visible. Runs before the
+    // trace-file guard so it works with tracing off - the RTL faults at
+    // ARM7 instruction ~30M, and a trace that long is several GB.
+    if (const char* plo = getenv("ARM7PROBE_LO"))
+    {
+        static bool seen = false;
+        if (!seen)
+        {
+            u32 lo = (u32)strtoul(plo, nullptr, 16);
+            u32 hi = lo;
+            if (const char* phi = getenv("ARM7PROBE_HI"))
+                hi = (u32)strtoul(phi, nullptr, 16);
+            if (pc >= lo && pc <= hi)
+            {
+                printf("ARM7PROBE first pc=%08x in [%08x..%08x] cpsr=%08x T=%d instr=%08x\n",
+                       pc, lo, hi, cpsr, (cpsr >> 5) & 1, instr);
+                fflush(stdout);
+                seen = true;
+            }
+        }
+    }
+    // NDS_MiSTfits: ARM7CB=1 logs the ARM7 BIOS's callback trampolines. The
+    // BIOS SWI dispatcher (0x2ddc -> 0x2de0) does `bx ip` off a table, so lr is
+    // always 0x2E10 and CPSR is always System/ARM inside any SWI handler - which
+    // is the state the RTL faults in. The *ReadByCallback SWIs (0x12/0x13/0x15)
+    // then reach a caller-supplied function pointer through two one-instruction
+    // Thumb trampolines in BIOS:
+    //     0x3300: bx r1     (the readbyte callback, struct[8])
+    //     0x3304: bx r3     (the open callback,     struct[0])
+    // pc here is R15 = addr+4 in Thumb, hence 0x3304 / 0x3308.
+    //
+    // Only targets outside the BIOS are logged: the BIOS's own firmware-boot
+    // callback struct lives at 0x33E0, so a RAM target means the FIRMWARE'S OWN
+    // code is calling a decompression SWI with its own callbacks. bit0 of the
+    // target is the whole question - it is what puts `bx` into Thumb state.
+    if (const char* cbmin = getenv("ARM7CB"))
+    {
+        static int cbn = 0;
+        u32 lo = (u32)strtoul(cbmin, nullptr, 16);   // ARM7CB=0 logs every hit
+        u32 tgt = 0; const char* which = nullptr;
+        if      (pc == 0x3304) { tgt = r[1]; which = "bx r1 (readbyte)"; }
+        else if (pc == 0x3308) { tgt = r[3]; which = "bx r3 (open)"; }
+        if (which && tgt >= lo && cbn < 64)
+        {
+            printf("ARM7CB %-17s target=%08x thumb_bit=%d cpsr=%08x lr=%08x\n",
+                   which, tgt, tgt & 1, cpsr, r[14]);
+            fflush(stdout);
+            cbn++;
+        }
+    }
+    // NDS_MiSTfits: ARM7REGS_AT=<hex R15> dumps every execution of one
+    // instruction with all of r0..r14. Give it the R15 value, not the address:
+    // pc here is addr+8 in ARM and addr+4 in Thumb, which is the same bias the
+    // RTL's dbg_export uses - and mixing the two up is what made the earlier
+    // ARM7PROBE readings look like an 8-byte memory displacement when the two
+    // memories were in fact identical.
+    if (const char* rp = getenv("ARM7REGS_AT"))
+    {
+        static int rn = 0;
+        if (pc == (u32)strtoul(rp, nullptr, 16) && rn < 24)
+        {
+            printf("ARM7REGS pc=%08x instr=%08x cpsr=%08x mode=%02x T=%d\n",
+                   pc, instr, cpsr, cpsr & 0x1F, (cpsr >> 5) & 1);
+            for (int i = 0; i < 15; i += 5)
+                printf("   r%-2d %08x  r%-2d %08x  r%-2d %08x  r%-2d %08x  r%-2d %08x\n",
+                       i, r[i], i+1, r[i+1], i+2, r[i+2], i+3, r[i+3], i+4, r[i+4]);
+            fflush(stdout);
+            rn++;
+        }
+    }
+    if (!ARM7TraceFile || ARM7TraceCount >= ARM7TraceMax) return;
+    fprintf(ARM7TraceFile, "%08x %08x %08x", pc, instr, cpsr);
+    for (int i = 0; i < 15; i++) fprintf(ARM7TraceFile, " %08x", r[i]);
+    fputc('\n', ARM7TraceFile);
+    ARM7TraceCount++;
+}
