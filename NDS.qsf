# --------------------------------------------------------------------------
#
# MiSTer project (NDS_MiSTfits)
#
# WARNING WARNING WARNING:
# Do not add files to project in Quartus IDE! It will mess this file!
# Add the files manually to files.qip file.
#
# --------------------------------------------------------------------------

set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS OFF
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE PERFORMANCE"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS "SPARSE AUTO"
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA OFF
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
# MEASURED 2026-08-06, do not retry: with SOUND_ENABLE=1 the design misses by
# 27 LABs (4218 vs 4191). Setting this to HIGH *and* PHYSICAL_SYNTHESIS_COMBO_
# LOGIC_FOR_AREA to ON made it WORSE, not better - 4218 -> 4223 LABs, 41,644 ->
# 41,652 ALMs. Neither lever buys area here; the fix was gating nds_debug.
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT LOW
# Tried PLACEMENT_EFFORT_MULTIPLIER 3.0 with ROUTER_TIMING_OPTIMIZATION_LEVEL
# MAXIMUM (build artifacts-t3): worst slack -2.499 -> -4.104, TNS -790 -> -3356,
# with new offenders in DSP logic (dblsat, dsp_rb) that no source change had
# touched. But the seed spread on an UNCHANGED netlist is 1.53 ns (t5 at seeds
# 0/3/7 = -2.535/-4.065/-3.046), so that single sample does not establish the
# setting as harmful - only that it did not help and cost build time. Left at
# the default; sweeping seeds is measurably worth more than placer effort.
set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 1.0
# With SOUND_ENABLE=1 + DEBUG_ENABLE=0 the design PLACES (the 170012 LAB error is
# gone at 41,241 ALMs) but the ROUTER gives up: peak interconnect 79% around
# X11_Y35..X21_Y45, "Fitter routing phase terminated due to routing congestion".
# This is Quartus's own first suggestion for 188026, and it only costs fit time.
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name SEED 0
# NOHDMI removes ascal + pll_hdmi + hdmi_osd + shadowmask. MEASURED 2026-08-08:
# turning HDMI back on costs ~3,500-4,000 ALMs, +51 LABs and +51 M10K (HDMI
# builds sit at 517/553 RAM blocks vs 466). The M10K half is as binding as the
# logic - see build/artifacts-aff-hdmi against build/artifacts-objdec.
#
# When HDMI does go back on, do it with a FIXED-RESOLUTION SPG rather than
# ascal: skmp (polly2) puts a fixed-res video-out path at ~400 ALMs and points
# at polly2's SPG.sv. That displaces ascal's 2,178 but NOT hdmi_osd (486) or
# shadowmask (137), so budget ~2,200, not 400 - and note that is essentially
# the ~2,000 already assumed, so it does NOT buy SOUND_ENABLE=1 + HDMI
# together. Unverified against MiSTer's sys_top interface; scope-ablate before
# believing the number. This image is analog-only (VGA/YC), IO-board required.
set_global_assignment -name VERILOG_MACRO "MISTER_DEBUG_NOHDMI=1"
set_global_assignment -name VERILOG_MACRO "MISTER_FB=0"

# disable bilinear filtering when downscaling
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"

# disable adaptive scanline filtering
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"

# Disable YC / Composite output to save some resources.
# MEASURED 2026-08-08: yc_out is 235 ALMs + 2 DSPs in every build to date.
# Still untried - free if composite/S-video is not a target.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"

# Disable ALSA audio output to save some resources
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

# This fit profile already removes HDMI and requires the analog I/O board. Do
# not spend fabric generating I2S or S/PDIF streams that have no sink here; keep
# the sigma-delta DAC path, including MiSTer's volume and stereo-mix controls.
# The removed blocks measure 71 combinational ALUTs and 102 registers in the
# exact-cadence build (i2s + spdif hierarchy rows).
set_global_assignment -name VERILOG_MACRO "NDS_ANALOG_AUDIO_ONLY=1"

# Bypass MiSTer's IIR audio low-pass and 40-bit DC blockers (a LOCAL patch to
# sys/audio_out.v, guarded so the vendored file still builds unmodified when
# this is off). nds_sound already emits signed, bias-adjusted samples; these are
# output post-filters, not emulated SPU state.
# MEASURED before the DC-bypass extension: IIR_filter is ~430 ALMs (~43 LABs).
# This image is LAB-bound, not
# ALM-bound - with SOUND_ENABLE=1 + PQ_DEPTH=16 the fitter needed 4,192..4,215
# LABs against 4,191 across five seeds (0,1,2,3,5), i.e. it missed by as little
# as ONE. This is what pays for keeping PQ_DEPTH=16, which is worth 8 fewer
# dropped scanlines per frame (see the table in rtl/nds_drawer_obj.vhd).
# Cost: no audio filtering. Turn it off again the moment nds_sound shrinks.
set_global_assignment -name VERILOG_MACRO "NDS_NO_AUDIO_FILTER=1"

# clkMem 4x = 134.055928 MHz instead of 3x = 100.541946 MHz. This ONE macro
# moves both the PLL (rtl/pll/pll_0002.v) and every clk1x-crossing phase index
# (NDS.sv CLKMEM_RATIO), because a 4x PLL with 3x indices would accept a
# renderer read the core is still holding and serve it twice.
#
# Measured on this machine's SDRAM module: 134 MHz pinned, zero MemTest errors
# over ~3 hours. That is the MODULE side only. The official MiSTer bar is
# 130 MHz, so comment this out for a build meant for anyone else - the renderer
# is already under its line budget at 3x and 4x only closes the last few
# dropped lines.
#
# FPGA side, and the reason this is worth a timing check every time it moves:
# the clk_mem -> clk_sys setup budget is ONE clkMem period, so it shrinks
# 9.94 -> 7.46 ns. At 3x the worst such path (vr_busy -> nds_vram|rdr_*_dout)
# had only +1.107 ns, so it is the first thing expected to fail here.
#
# MEASURED 2026-08-05.
#
# 1. Area is NOT this macro's fault. At 100% ALM neither ratio fitted, and 4x was
#    the smaller of the two (41,724 ALMs / 4223 LABs against 41,837 / 4238; the
#    device has 4191 LABs). The overflow was pre-existing on main. With
#    SOUND_ENABLE=0 the design drops to 34,324 ALMs (82%) and fits comfortably.
#
# 2. Timing before the sdram.sv work (build/artifacts-nosnd-4x):
#
#      outclk_0 clk_mem 134.056 MHz : setup -0.846 ns, TNS -9.496
#      outclk_2 clk_sys  33.514 MHz : setup -0.508 ns, TNS -26.268
#      outclk_1 video    67.028 MHz : setup +5.630 ns  (fine)
#      plus a hold violation on clk_sys, -0.364 ns
#
#    Those numbers are a measurement, not a veto - the owner's call is that small
#    negative slack is tolerable on this machine, so re-measure when this moves
#    and judge the size, rather than treating any red as blocking. See
#    docs/SDRAM.md for what the sdram.sv side of that gap turned out to be.
#
# 3. RE-MEASURED 2026-08-06 on current main, both shipping configs. It FITS in
#    both and MISSES TIMING in both, and the two configs fail on DIFFERENT
#    families - which is what says this is two separate pieces of work, not one:
#
#      audio (97% ALM, build/artifacts-4x-audio)
#        clk_sys -1.166  clk_mem -0.756
#        48 of the top 50 paths: vr_pend / vr_out[1] (clk_mem)
#          -> nds_vram|rdr_*_dout[*] (clk_sys), required 7.459 ns
#      debug (91% ALM, build/artifacts-4x-dbg)
#        clk_sys +0.052  clk_mem -0.733
#        top family entirely inside sdram.sv: ch1_rq / state.* -> SDRAM_A[7:8]
#
#    -0.75 ns is 10% of the 134 MHz period. That is the "different thing from a
#    -0.05 ns nick" class, not the tolerable class.
#
#    The core-side family is the cost of the vrsrv pipelining (e092dc4): rsrv_ready
#    gates nds_vram's ISSUE stage, the issue stage updates v_rq/v_tail/v_cnt, and
#    the RETIRE stage reads those same variables in the same cycle to drive
#    rdr_*_dout - so ready reaches the data registers combinationally, across the
#    domain, with only one clkMem period to do it in. Registering rsrv_ready is NOT
#    the fix; nds_vram.vhd:851 names that as the stale-ready wedge. The fix is to
#    retire from the PRE-issue queue state (the `rq` signal, not the `v_rq`
#    variable), which costs one cycle on an empty queue and breaks the cone.
#
# 4. WHAT 4x IS WORTH, measured before doing any of that work (sim, CE_DIV=1,
#    channel modelled at its real depth and slot throughput, RSRV_OUT=2 with
#    RSRV_GAP 3 -> 2):
#
#      scene            cyc/line 3x -> 4x      dropped lines 3x -> 4x
#      nds_2dk (system)   1349 -> 1064 (-21%)      4 -> 4
#      vectors case 0     1019 ->  814 (-20%)      4 -> 4
#      vectors case 1     1578 -> 1326 (-16%)    132 -> 132
#
#    So it is a real 16-21% off the renderer line - far more than a latency-only
#    model suggests, because this channel is THROUGHPUT-bound - and it saves
#    ZERO dropped lines. Drops come from a heavy tail (case 1 drops 23% of lines
#    at a mean of 74% of budget), and shaving 20% off every line does not bring
#    an outlier at 2x budget back inside it. Overclocking buys headroom to spend
#    later; it is not the fix for dropped lines.
#
#    (Note 4's "dropped lines" are now understood and are NOT structural: the OBJ
#    drawer costs ~3,036 cycles against 2,130 on lines that carry sprites, 15x its
#    own baseline, because it is the one drawer of four without the accept-based
#    pipelined VRAM protocol. See nds_drawer_obj.vhd:684. No memory clock fixes
#    that, which is exactly why 4x moved the mean and not the drops.)
#
# 5. FIXED 2026-08-07, one of the two families. Staging nds_vram's A..D
#    line-cache hit removes the ENTIRE vr_pend/vr_out -> rdr_*_dout family:
#
#      audio  clk_sys -1.166 -> +0.996   clk_mem -0.756 -> -0.515   (98% ALM)
#      debug  clk_sys +0.052 -> +0.471   clk_mem -0.733 -> -0.432   (91% ALM)
#
#    What is left in BOTH is only sdram.sv: ch1_rq / state.* -> SDRAM_A[7:8].
#
# 6. THAT ONE IS NOT WORTH FIXING YET, and the reasons are measured, not assumed:
#
#    - It is not seed noise. Seeds 0 and 3 give -0.515 and -0.778, a 0.26 ns
#      spread, both negative; seed 3 also pulls in SDRAM_A[11] from sd_vs_req and
#      mr_sdram_ena. It is the channel-arbitration mux, from several channels.
#    - The SDRAM_A registers are ALREADY packed into the I/O cells ("Fast Output
#      Register assignment", pin AC23, column I/O), so the delay is the priority
#      mux plus the route out to the I/O column.
#    - DO NOT "fix" it by unpacking them from the IOE. There are no
#      set_output_delay constraints on the SDRAM pins, so flop->pin is untimed:
#      that would turn the number green while making the real pin timing worse.
#      Same class of mistake as the ch1_ready off-by-one.
#    - Both legitimate fixes - pre-arbitrating the row address, or pipelining the
#      whole command/address/DQ-capture bus by one clock - cost ONE clkMem cycle
#      per transaction. The ch1 slot goes 8 -> 9, so 4x's renderer-VRAM throughput
#      gain over 3x falls from 33% to 19%.
#
#    Spending a third of the only benefit, on an overclock measured in note 4 to
#    save zero dropped lines, to close 0.5 ns. Revisit if the 3D work needs the
#    memory bandwidth; not before.
# set_global_assignment -name VERILOG_MACRO "NDS_CLKMEM_4X=1"

# HPS lightweight-bridge debug window at physical 0xFF200000
# (rtl/hps_lw_bridge.sv). Gives the ARM direct register access to nds_debug and
# to live PC/CPSR/status taps: ~150-300 ns per access against the DDR3 mailbox's
# ~122 us poll, and the live taps need no command at all, which is what makes a
# renderer counter watchable while it wedges.
#
# UNVERIFIED ON SILICON. The HPS end has to be enabled by the running Linux; if
# it is held in reset an access HANGS rather than failing. Run
# `nitrodbg.sh lwtest` before relying on it, and see the header of
# rtl/hps_lw_bridge.sv. Costs area, so leave it off for a release image.
# set_global_assignment -name VERILOG_MACRO "NDS_LW_DEBUG=1"

# HPS audio ring at DDR3 0x0FFD0000 (HPS 0x3FFD0000): the FPGA end of the sound
# pipe the SPU is moving onto the ARM. See rtl/nds_audio_ddr3.sv and
# docs/HPS_AUDIO.md.
#
# ON by default, unlike the two switches above, because it is not a debug aid -
# it is where audio comes from once nds_sound is gone, and today's shipping
# default (SOUND_ENABLE=0) has no audio at all. It is inert until the magic word
# appears in DDR3, so turning it on cannot change how an existing image behaves;
# the only cost is area, and it is left switchable so that area stays A/B-able
# against the rest of the fitting war.
# OFF for a SOUND_ENABLE=1 image: with the fabric SPU present the ring has no
# producer and no consumer, and it measures 197.9 ALMs (nds_audio_ddr3:u_audio,
# artifacts-perf entity table) that this configuration cannot spare.
# set_global_assignment -name VERILOG_MACRO "NDS_HPS_AUDIO=1"

# Drops ascal + pll_hdmi so the design fits, and removes the HDMI clock domain.
# No HDMI out; direct_video carries analog.
#
# COST MEASURED 2026-08-06: ~3,600 ALMs, not the "~2k" this comment claimed for
# months (37,958 with HDMI + sound off, against 34,386 with neither). That
# matters because it is what decides whether audio and HDMI can coexist: the
# audio image is 41,024, so +3,600 lands at ~44,600 against 41,910. THEY CANNOT
# BOTH BE ON until nds_sound shrinks by ~2,700 ALMs. See FITTING.md.
#
# The old note here also said this domain "fails setup on nearly every seed".
# It closed at +0.352 on seed 3 and +0.242 before that, so treat that as
# folklore rather than a reason not to try. No HDMI out; direct_video carries analog.

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
source clash/clash.tcl
set_global_assignment -name OPTIMIZE_POWER_DURING_SYNTHESIS OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT EXTRA
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
