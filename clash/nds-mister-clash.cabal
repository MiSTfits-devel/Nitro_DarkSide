                    , Nds.Gpu3D.RasterHw.Pixel
                    , Nds.Gpu3D.RasterHw.TexCache
                    , Nds.Gpu3D.RasterHw.Line
                    , Nds.Gpu3D.ChipHw
                    , Nds.Gpu3D.TraceReplay
                    , Nds.Gpu2D.Capture
                    , Nds.Gpu2D.Line
                    , Nds.Gpu2D.Speculate
                    , Nds.Gpu2D.Sprite
                    , Nds.Gpu2D.Tardis
                    , Nds.Gpu2D.Trace
                    , Nds.Gpu2D.TraceRender
                    , Nds.Gpu2D.TraceState
                    , Nds.Gpu2D.Types
                    , Nds.Gpu.Unified
  hs-source-dirs:     src
  build-depends:      base >=4.14 && <5
                    , clash-prelude >=1.6 && <1.11
                    , containers
                    , array
                    , bytestring
  default-language:   GHC2021

executable flat-check
  main-is:            FlatCheck.hs
  hs-source-dirs:     test
  build-depends:      base >=4.14 && <5
                    , nds-mister-clash
                    , containers
  default-language:   GHC2021
  ghc-options:        -O2

